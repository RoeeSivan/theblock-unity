# Unity generated - all rebuildable from Assets/ + ProjectSettings/ + Packages/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta files for folders Unity ignores
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# IDE / editor
.vscode/
.idea/
.vs/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
