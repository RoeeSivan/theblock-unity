# Crashlytics
crashlytics-build.properties

# Port pipeline: generated from the web project, never hand-edited
/[Aa]ssets/StreamingAssets/theblock-config.json

# Editor screenshots — throwaway captures, would otherwise eat the shared LFS quota
/Assets/Screenshots/
/Assets/Screenshots.meta

# District source GLBs — 40-70 MB each, authoritative copies live in
# ~/TheBlockSource/cities/. Free LFS is 1 GiB and shared with the original repo,
# so these stay out. first-one.glb is exempt: 240 KB and the ONLY copy anywhere.
/Assets/Models/City/procedural-city-*.glb
/Assets/Models/City/procedural-city-*.glb.meta

# WorldBuilder's generated output. The stripped district meshes are ~15 MB each and the
# alpha-clip materials point at textures inside those same gitignored .glbs — both are
# derived assets that every Build World rewrites from scratch and sweeps when stale, so
# committing them would cost LFS quota to store something that is never read.
/Assets/Meshes/Generated/
/Assets/Meshes/Generated.meta

# Road/water/sand materials and the road surface texture, all written by WorldBuilder
# and swept by it. Same reason as the generated meshes: reproducible, not authored.
/Assets/Materials/World/Generated/
/Assets/Materials/World/Generated.meta
/Assets/Materials/City/Cutout/
/Assets/Materials/City/Cutout.meta

# Character source FBX over 10 MB — raw Mixamo downloads, authoritative copies live in
# the game repo at source-assets/models/. Same LFS reasoning as the district GLBs.
/Assets/Models/Characters/Joe.fbx
/Assets/Models/Characters/Joe.fbx.meta
/[Aa]ssets/StreamingAssets/theblock-config.json.meta

# Jump animation FBX — 54 MB raw Mixamo download, same LFS reasoning as Joe.fbx.
/Assets/Models/Characters/Joe_Jumping.fbx
/Assets/Models/Characters/Joe_Jumping.fbx.meta
/Assets/Models/Characters/Joe_Sprint.fbx
/Assets/Models/Characters/Joe_Sprint.fbx.meta

# U15's compressed district textures, and the material clones that point at them. Both are
# extracted from the gitignored district .glbs by The Block → Compress Textures, so they are
# derived assets with no source of their own here — and they are ~1 GB, which is the whole free
# LFS quota several times over.
/Assets/Textures/Generated/
/Assets/Textures/Generated.meta
/Assets/Materials/City/Compressed/
/Assets/Materials/City/Compressed.meta

# Lot-car paint materials — one per model per palette colour, written by WorldBuilder and
# swept by it. Same reasoning as the cutout materials: derived from the config's palette,
# rewritten by every Build World.
/Assets/Materials/LotCars/
/Assets/Materials/LotCars.meta
